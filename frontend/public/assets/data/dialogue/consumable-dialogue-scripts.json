{
  "scripts": [
    {
      "id": "mountains-llamaver-energy-gift",
      "title": "A Brightly Misplaced Supply",
      "summary": "Llamaver mistakes the goblin for someone expected, or possibly unexpected, and shares an energy-restoring ration first.",
      "tags": ["consumables", "traveler"],
      "trigger": {
        "scene": "run-dialogue",
        "node_type": "dialogue",
        "region_slug": "mountains",
        "tags": ["consumables"]
      },
      "presentation": {
        "background_url": "/assets/ui/biome/mountain.png"
      },
      "speakers": [
        {
          "id": "player",
          "side": "left",
          "party": "player",
          "role": "player"
        },
        {
          "id": "llamaver",
          "side": "right",
          "name": "Llamaver",
          "portrait_url": "/assets/ui/units/animated/llamaver/frame_0.png",
          "party": "neutral",
          "role": "npc"
        }
      ],
      "start_step_id": "llamaver-oh-good",
      "steps": [
        {
          "id": "llamaver-oh-good",
          "speaker_id": "llamaver",
          "text": "Oh good, you found me. Or I found this ridge. Either way, tremendous progress.",
          "next_step_id": "player-found"
        },
        {
          "id": "player-found",
          "speaker_id": "player",
          "text": "Were you looking for me?",
          "next_step_id": "llamaver-considers"
        },
        {
          "id": "llamaver-considers",
          "speaker_id": "llamaver",
          "text": "I was looking for the next helpful person. You are next, and possibly helpful. Splendid fit.",
          "next_step_id": "player-gift"
        },
        {
          "id": "player-gift",
          "speaker_id": "player",
          "text": "Helpful people give things.",
          "next_step_id": "llamaver-ration"
        },
        {
          "id": "llamaver-ration",
          "speaker_id": "llamaver",
          "text": "Yes, exactly. Here, an energizing travel ration. I packed it for a climb, or a nap, or both in the wrong order.",
          "next_step_id": "player-energy"
        },
        {
          "id": "player-energy",
          "speaker_id": "player",
          "text": "I will spend it incorrectly.",
          "next_step_id": "llamaver-best"
        },
        {
          "id": "llamaver-best",
          "speaker_id": "llamaver",
          "text": "Wonderful. Incorrect use is often how maps learn new roads."
        }
      ]
    },
    {
      "id": "mountains-llamaver-health-gift",
      "title": "The Other Useful Bundle",
      "summary": "Llamaver remembers the second half of their helpful errand and offers a field poultice for wounded run units.",
      "tags": ["consumables", "traveler"],
      "trigger": {
        "scene": "run-dialogue",
        "node_type": "dialogue",
        "region_slug": "mountains",
        "tags": ["consumables"]
      },
      "presentation": {
        "background_url": "/assets/ui/biome/mountain.png"
      },
      "speakers": [
        {
          "id": "player",
          "side": "left",
          "party": "player",
          "role": "player"
        },
        {
          "id": "llamaver",
          "side": "right",
          "name": "Llamaver",
          "portrait_url": "/assets/ui/units/animated/llamaver/frame_0.png",
          "party": "neutral",
          "role": "npc"
        }
      ],
      "start_step_id": "llamaver-there-you-are",
      "steps": [
        {
          "id": "llamaver-there-you-are",
          "speaker_id": "llamaver",
          "text": "There you are. I remembered the thing I forgot, which means I almost did not forget it.",
          "next_step_id": "player-thing"
        },
        {
          "id": "player-thing",
          "speaker_id": "player",
          "text": "Give me the thing before you forget again.",
          "next_step_id": "llamaver-wise"
        },
        {
          "id": "llamaver-wise",
          "speaker_id": "llamaver",
          "text": "Wise. Direct. A little alarming. This bundle patches wounds when the road gets too enthusiastic.",
          "next_step_id": "player-health"
        },
        {
          "id": "player-health",
          "speaker_id": "player",
          "text": "The road has been biting.",
          "next_step_id": "llamaver-poultice"
        },
        {
          "id": "llamaver-poultice",
          "speaker_id": "llamaver",
          "text": "Then this field poultice is perfectly timed, unless it was meant for yesterday. Still useful. Probably fresher than yesterday.",
          "next_step_id": "player-accept"
        },
        {
          "id": "player-accept",
          "speaker_id": "player",
          "text": "Good. I like useful maybe-medicine.",
          "next_step_id": "llamaver-bright"
        },
        {
          "id": "llamaver-bright",
          "speaker_id": "llamaver",
          "text": "That is the spirit. Keep enough of yourself attached to enjoy the view."
        }
      ]
    }
  ]
}
